# 复制成 .env 后修改。.env 已在 .gitignore 里，不会被提交。

# ---- vLLM（OpenAI 兼容接口）----
# 后端和 vLLM 在同一台机器、直接用 python 跑：http://localhost:8000/v1
# 用 docker compose 跑、vLLM 在宿主机：http://host.docker.internal:8000/v1
VLLM_BASE_URL=http://localhost:8000/v1
# 必须和 vLLM 启动时的模型名（或 --served-model-name）一致，可用 curl $VLLM_BASE_URL/models 查看
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# vLLM 如果用了 --api-key，这里填同一个；没有就留空
VLLM_API_KEY=
VLLM_TIMEOUT=300
# vLLM 支持时可以打开，让整理/追问稳定输出 JSON
VLLM_JSON_MODE=false
# 用 Qwen3 这类带思考模式的模型时设为 true（关闭 <think>，更快）
VLLM_DISABLE_THINKING=false
TEMPERATURE=0.4

# ---- Obsidian vault ----
# vault 在服务器上的绝对路径（docker compose 里用 VAULT_HOST_PATH，见下）
VAULT_PATH=/path/to/ObsidianVault
JOURNAL_DIR=Journal
INBOX_SUBDIR=Inbox
LANGUAGE=zh
# 在日记末尾保留折叠的原始语音转写
KEEP_RAW=true
# 不参与检索的文件夹（逗号分隔，Journal/Inbox 永远排除）
INDEX_EXCLUDE=.obsidian,.trash,.git

# ---- 检索 ----
# none = 只用 BM25（零显存，中文也能用）
# openai = 调用任意 OpenAI 兼容 /embeddings（例如另一个 vLLM/infinity/TEI 服务）
# local = 本机 CPU 跑 sentence-transformers（需要 pip install sentence-transformers）
EMBED_BACKEND=none
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
EMBED_DEVICE=cpu
SEARCH_TOP_K=8
CONTEXT_MAX_CHARS=6000

# ---- 语音转写 ----
# off / local（faster-whisper）/ openai（OpenAI 兼容 /audio/transcriptions）
WHISPER_BACKEND=off
# tiny / base / small / medium / large-v3 / large-v3-turbo
WHISPER_MODEL=small
# 3080 被 vLLM 占着，默认用 CPU
WHISPER_DEVICE=cpu
# CPU 用 int8；GPU 用 int8_float16 或 float16
WHISPER_COMPUTE_TYPE=int8
# zh = 中文为主（中英混说也能识别）；auto = 自动检测
WHISPER_LANGUAGE=zh
WHISPER_BASE_URL=
WHISPER_API_KEY=

# ---- Inbox 自动处理 ----
INBOX_ENABLED=false
INBOX_POLL_SECONDS=30
# 文件修改后至少等这么多秒再处理（等同步完成）
INBOX_SETTLE_SECONDS=15
# true = 不追问，直接生成日记
INBOX_SKIP_FOLLOWUPS=false
# 每小时更新 Journal/投资回看清单.md
REVIEW_DIGEST_ENABLED=false

# ---- 服务 ----
# 强烈建议设置：Obsidian 插件里填同一个值。生成方法：python -c "import secrets;print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=
CORS_ORIGINS=app://obsidian.md,capacitor://localhost,http://localhost
DATA_DIR=./data
HOST=127.0.0.1
PORT=8765

# ---- 只给 docker compose 用 ----
# vault 在宿主机上的路径，会挂载到容器的 /vault
VAULT_HOST_PATH=/path/to/ObsidianVault
# 映射端口时绑定的地址：127.0.0.1 只本机；填服务器的局域网 IP 让局域网访问。不要用 0.0.0.0 暴露到公网
BIND_ADDR=127.0.0.1
PUID=1000
PGID=1000
WITH_WHISPER=0
